{# Agent credential partial (web/agent_auth.py). `token` is set only on the
   one response that issued it; it is never rendered again. #}
<section class="admin-section agent-credential" aria-label="Your agent" data-testid="agent-credential">
  <h2>Your agent</h2>
  <p>Your personal agent connects to this lens over MCP at
    <code data-testid="agent-endpoint">{{ endpoint }}</code> as
    <code data-testid="agent-nick">{{ agent_nick }}</code>, with exactly your permissions.</p>
  {% if token %}
  <p class="entry-done" role="status">Copy this credential now. It is shown only once: the lens keeps only a hash of it.</p>
  <p><code class="agent-token" data-testid="agent-token">{{ token }}</code></p>
  <p class="admin-muted">Your agent sends it as <code>Authorization: Bearer &lt;credential&gt;</code>. It expires in {{ ttl_days }} day{{ "s" if ttl_days != 1 else "" }}.</p>
  {% elif active %}
  <p data-testid="agent-active">An agent credential is active. Issuing a new one replaces it and disconnects the agent using the old one.</p>
  {% else %}
  <p class="admin-muted" data-testid="agent-none">You have no active agent credential.</p>
  {% endif %}
  <form method="post" action="/agent-credential" class="admin-inline">
    <button type="submit" class="btn btn-primary" data-testid="agent-issue">Issue {% if active or token %}a new {% endif %}credential</button>
  </form>
</section>
