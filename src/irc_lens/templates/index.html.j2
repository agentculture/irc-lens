<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>culture — {{ session.nick }}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ static_url('favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ static_url('favicon-16x16.png') }}">
    <link rel="icon" href="{{ static_url('favicon.ico') }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ static_url('apple-touch-icon.png') }}">
    <meta name="color-scheme" content="dark">
    <link rel="stylesheet" href="{{ static_url('lens.css') }}">
    <meta name="htmx-config" content='{"includeIndicatorStyles":false,"allowEval":false}'>
    <script src="{{ static_url('vendor/htmx.min.js') }}" defer></script>
    <script src="{{ static_url('vendor/sse.js') }}" defer></script>
    <script src="{{ static_url('mesh.js') }}" defer></script>
    <script src="{{ static_url('logfollow.js') }}" defer></script>
    <script src="{{ static_url('lens.js') }}" defer></script>
    <script src="{{ static_url('chatui.js') }}" defer></script>
    <script src="{{ static_url('media.js') }}" defer></script>
  </head>
  {% set tier = session.ui_tier %}
  <body data-view="{{ session.view }}" data-tier="{{ tier }}" class="{% if tier != 'approved' %}lens-sandbox{% endif %}">
    <a class="lens-skip" href="#chat-input">Skip to input</a>
    <header class="lens-header">
      <button type="button" class="lens-rooms-btn" data-testid="rooms-toggle" aria-controls="sidebar" aria-expanded="false" aria-label="Rooms">
        <span aria-hidden="true">&#9776;</span>
      </button>
      <img class="lens-logo" src="{{ static_url('culture-logo.png') }}" alt="" width="24" height="24">
      <span class="lens-wordmark">culture</span>
      <span class="lens-tier lens-tier--{{ tier }}" data-testid="tier-badge">
        {%- if tier == "guest" %}Guest{% elif tier == "sandbox_preview" %}Sandbox preview{% else %}Real mesh{% endif -%}
      </span>
      <span class="lens-identity" data-testid="identity">{{ session.nick }}</span>
      <span class="lens-room" data-testid="header-room" id="header-room">{{ session.current_channel }}</span>
      <span data-testid="connection-status" class="lens-conn {{ 'lens-conn--healthy' if session.healthy else 'lens-conn--down' }}">
        {% if session.healthy %}connected{% else %}disconnected{% endif %}
      </span>
      {% if session.sandbox_available %}
        <button type="button" class="lens-btn" data-testid="sandbox-enter" hx-post="/sandbox/enter" hx-swap="none">Guest view</button>
      {% endif %}
    </header>
    {% if tier == "sandbox_preview" %}
      <div class="lens-banner" data-testid="sandbox-banner" role="status">
        <strong>Guest view</strong>
        <button type="button" class="lens-btn lens-btn--amber" data-testid="sandbox-leave" hx-post="/sandbox/leave" hx-swap="none">Back to mesh</button>
      </div>
    {% endif %}

    <main class="lens-grid">
      <aside data-testid="sidebar" id="sidebar" class="lens-sidebar" aria-label="Rooms and members">
        {% include "_sidebar.html.j2" %}
      </aside>

      <section class="lens-chat">
        <div class="lens-room-head" data-testid="room-head">
          <h1 class="lens-room-name" id="room-name">{{ session.current_channel or "No room" }}</h1>
          {# h58: an empty state names its next step. #}
          <span class="lens-empty-hint" id="empty-hint" data-testid="empty-hint"{% if session.current_channel %} hidden{% endif %}>Type /join #room</span>
          {% if presence is not none and presence is defined %}
            {% include "_presence.html.j2" %}
          {% endif %}
        </div>
        <div data-testid="chat-log" id="chat-log" class="lens-log" role="log" aria-label="Messages">
          {# Initial page render: server-fetched HISTORY for current_channel
             arrives pre-rendered as `chat_log_html`. Live messages keep
             arriving via SSE `chat` events. Page reloads re-fetch fresh
             history from the IRCd's SQLite store. #}
          {{ chat_log_html|safe }}
        </div>
        {# Live agent-mesh graph (mesh.js / window.LensMesh). Shares the
           center column's content row with the chat log; CSS shows exactly
           one based on <body data-view>. The input form below stays usable
           in mesh view so the user can switch away. Fed by the `mesh` SSE
           event; the canvas only animates while this pane is on screen. #}
        <section
          data-testid="mesh"
          id="mesh-pane"
          class="lens-mesh"
          role="img"
          aria-label="Live agent-mesh graph: joined channels as rooms, their members as agents and humans, connections as edges, with messages travelling the links.">
          <canvas id="mesh-canvas"></canvas>
        </section>
        {# Upload UI (task t8): attach button + hidden file input live
           outside <form id="chat-form"> on purpose — a nameless input
           wouldn't serialize into the form body anyway, but keeping it
           out of the htmx-bound form means a future hx-encoding tweak
           on #chat-form can never accidentally multipart-encode typed
           chat messages. The static upload script drives both from
           here: the button opens the picker and uploads on change;
           drag-drop targets #chat-log; paste targets #chat-input. #}
        {% if tier == "approved" %}
        <div class="lens-media-controls">
          <button type="button" data-testid="media-attach" aria-label="Attach media">📎 attach</button>
          <button type="button" data-testid="media-record" aria-label="Record audio">🎙 record</button>
          <input
            type="file"
            accept="image/*,audio/*"
            data-testid="media-file-input"
            hidden>
        </div>
        {% endif %}
        <div class="lens-composer">
          <ul id="cmd-palette" class="lens-palette" data-testid="command-palette" role="listbox" aria-label="Commands" hidden>
            {% for entry in session.palette() %}
              <li role="option" id="cmd-{{ loop.index }}" data-cmd="{{ entry.command }}" data-href="{{ entry.href }}" aria-selected="false">
                <span class="lens-cmd">{{ entry.command }}</span><span class="lens-cmd-desc">{{ entry.label }}</span>
              </li>
            {% endfor %}
          </ul>
          <form id="chat-form" class="lens-form" hx-post="/input" hx-trigger="submit" hx-swap="none">
            <input
              data-testid="chat-input"
              id="chat-input"
              name="text"
              type="text"
              autocomplete="off"
              aria-label="Message"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="cmd-palette"
              placeholder="Message or /">
            <button data-testid="chat-submit" id="chat-submit" type="submit">Send</button>
          </form>
        </div>
      </section>

      <aside data-testid="info" id="info" class="lens-info" aria-label="Details">
        {% include "_info.html.j2" %}
      </aside>
    </main>

    <div id="toast-region" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
